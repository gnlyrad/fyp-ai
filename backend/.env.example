# Local development defaults. Ollama must be running before starting the API.
CLEARCALL_LLM_PROVIDER=ollama
CLEARCALL_RETRIEVAL_PROVIDER=local
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_TIMEOUT_SECONDS=120
CLEARCALL_JOB_DB_PATH=artifacts/clearcall_jobs.sqlite3

# Production RAG path. Keep secrets out of source control and inject them through
# your deployment platform or a secrets manager.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_CHAT_DEPLOYMENT=
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_SEARCH_ENDPOINT=
AZURE_SEARCH_API_KEY=
AZURE_SEARCH_INDEX=
AZURE_SEARCH_API_VERSION=2025-09-01
AZURE_SEARCH_SEMANTIC_CONFIGURATION=
REGULATORY_CONTEXT_PATH=

# Optional: set these when running against AWS SageMaker managed MLflow.
MLFLOW_TRACKING_URI=
MLFLOW_EXPERIMENT_NAME=clearcall-compliance-evaluation
AWS_REGION=ap-southeast-1
