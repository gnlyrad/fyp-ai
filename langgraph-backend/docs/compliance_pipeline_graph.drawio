<mxfile host="app.diagrams.net"><diagram id="compliance-pipeline" name="compliance_pipeline graph"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1180" pageHeight="2164" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n2" value="&lt;b style='font-size:20px'&gt;compliance_pipeline &amp;#8212; LangGraph nodes&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="20" width="1160" height="40" as="geometry"/></mxCell><mxCell id="n3" value="START&lt;br&gt;&lt;span style='font-size:10px'&gt;input: s3_url&lt;/span&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="520.0" y="80" width="120" height="44" as="geometry"/></mxCell><mxCell id="n4" value="&lt;div style='text-align:left;padding:4px 6px'&gt;&lt;b style='font-size:14px'&gt;ingest&lt;/b&gt;&lt;span style='float:right;font-size:10px;color:#555'&gt;code&lt;/span&gt;&lt;ul style='margin:6px 0 4px 0;padding-left:16px;font-size:11px'&gt;&lt;li&gt;Input precedence: s3_url &amp;gt; results &amp;gt; raw_transcript&lt;/li&gt;&lt;li&gt;Fetch the Transcribe JSON from S3 (boto3 GetObject; presigned URL via plain HTTPS)&lt;/li&gt;&lt;li&gt;Merge words + speaker labels into one segment per speaker turn (seg_0001, ...)&lt;/li&gt;&lt;li&gt;Segment text is immutable from here; all evidence offsets point into it&lt;/li&gt;&lt;/ul&gt;&lt;div style='font-size:10px;color:#444'&gt;&lt;i&gt;writes:&lt;/i&gt; call_id, segments, transcript, dual_channel&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#d5e8d4;strokeColor=#82b366;verticalAlign=top;align=left;" vertex="1" parent="1"><mxGeometry x="330" y="169" width="500" height="140" as="geometry"/></mxCell><mxCell id="n5" value="&lt;div style='text-align:left;padding:4px 6px'&gt;&lt;b style='font-size:14px'&gt;quality_check&lt;/b&gt;&lt;span style='float:right;font-size:10px;color:#555'&gt;code&lt;/span&gt;&lt;ul style='margin:6px 0 4px 0;padding-left:16px;font-size:11px'&gt;&lt;li&gt;short_call (&amp;lt; 60 s), low_confidence (avg word confidence &amp;lt; 0.80)&lt;/li&gt;&lt;li&gt;single_speaker, empty_transcript, dual_channel&lt;/li&gt;&lt;li&gt;Flags never stop the graph; they surface on the dashboard&lt;/li&gt;&lt;/ul&gt;&lt;div style='font-size:10px;color:#444'&gt;&lt;i&gt;writes:&lt;/i&gt; quality_flags&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#d5e8d4;strokeColor=#82b366;verticalAlign=top;align=left;" vertex="1" parent="1"><mxGeometry x="330" y="354" width="500" height="115" as="geometry"/></mxCell><mxCell id="n6" value="&lt;div style='text-align:left;padding:4px 6px'&gt;&lt;b style='font-size:14px'&gt;role_inference&lt;/b&gt;&lt;span style='float:right;font-size:10px;color:#555'&gt;LLM&lt;/span&gt;&lt;ul style='margin:6px 0 4px 0;padding-left:16px;font-size:11px'&gt;&lt;li&gt;Map spk_0 / spk_1 to Advisor / Client from the first 12 segments&lt;/li&gt;&lt;li&gt;Keep a role only when confidence &amp;gt;= 0.6&lt;/li&gt;&lt;li&gt;Skipped: caller-supplied speaker_roles, or dual-channel (channel -&amp;gt; role in code)&lt;/li&gt;&lt;/ul&gt;&lt;div style='font-size:10px;color:#444'&gt;&lt;i&gt;writes:&lt;/i&gt; segments[].role, speaker_roles&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#dae8fc;strokeColor=#6c8ebf;verticalAlign=top;align=left;" vertex="1" parent="1"><mxGeometry x="330" y="514" width="500" height="120" as="geometry"/></mxCell><mxCell id="n7" value="&lt;div style='text-align:left;padding:4px 6px'&gt;&lt;b style='font-size:14px'&gt;call_intent  (Stage 1: facts, C02)&lt;/b&gt;&lt;span style='float:right;font-size:10px;color:#555'&gt;LLM&lt;/span&gt;&lt;ul style='margin:6px 0 4px 0;padding-left:16px;font-size:11px'&gt;&lt;li&gt;enquiry | execution_only | advisory&lt;/li&gt;&lt;li&gt;Reports the most regulated intent reached during the call&lt;/li&gt;&lt;li&gt;Evidence quotes resolved to segment refs in code; unsupported observations dropped&lt;/li&gt;&lt;/ul&gt;&lt;div style='font-size:10px;color:#444'&gt;&lt;i&gt;writes:&lt;/i&gt; call_intent&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#dae8fc;strokeColor=#6c8ebf;verticalAlign=top;align=left;" vertex="1" parent="1"><mxGeometry x="330" y="679" width="500" height="120" as="geometry"/></mxCell><mxCell id="n8" value="&lt;b&gt;_route_to_checks&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;conditional edge&lt;br&gt;Send() one branch per Stage 2 item&lt;/span&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="460.0" y="844" width="240" height="100" as="geometry"/></mxCell><mxCell id="n9" value="&lt;b&gt;check_item&lt;/b&gt; &amp;#215; 5 &amp;#8212; Stage 2: checks, run in parallel &lt;span style='font-size:10px'&gt;(LLM)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;dashed=1;fillColor=none;strokeColor=#6c8ebf;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=13;" vertex="1" parent="1"><mxGeometry x="60" y="989" width="1040" height="310" as="geometry"/></mxCell><mxCell id="n10" value="&lt;b&gt;C01&lt;/b&gt;&lt;br&gt;Identity and authority" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="80.0" y="1024" width="188" height="80" as="geometry"/></mxCell><mxCell id="n11" value="&lt;b&gt;C03&lt;/b&gt;&lt;br&gt;Instruction validity" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="283.0" y="1024" width="188" height="80" as="geometry"/></mxCell><mxCell id="n12" value="&lt;b&gt;C04&lt;/b&gt;&lt;br&gt;Product eligibility" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="486.0" y="1024" width="188" height="80" as="geometry"/></mxCell><mxCell id="n13" value="&lt;b&gt;C05&lt;/b&gt;&lt;br&gt;Client understanding and disclosures" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="689.0" y="1024" width="188" height="80" as="geometry"/></mxCell><mxCell id="n14" value="&lt;b&gt;C06&lt;/b&gt;&lt;br&gt;Restrictions and red flags&lt;br&gt;&lt;span style='font-size:10px'&gt;+ red flags&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="892.0" y="1024" width="188" height="80" as="geometry"/></mxCell><mxCell id="n15" value="&lt;div style='text-align:left;font-size:11px'&gt;&lt;ul style='margin:0;padding-left:16px'&gt;&lt;li&gt;Each branch gets: the cached MAS rules for its item (data/rule_cache.json), its question and sub-criteria from config/checklist.yaml, the transcript segments, and call_intent&lt;/li&gt;&lt;li&gt;LLM answers each sub-criterion (PASS / FAIL / NOT_APPLICABLE / CANNOT_DETERMINE) with short evidence quotes&lt;/li&gt;&lt;li&gt;Code rolls sub-criteria up into the item status and resolves quotes into segment + char-span refs&lt;/li&gt;&lt;li&gt;Reviewer warnings attached (never change a status); C06 also returns red flags&lt;/li&gt;&lt;/ul&gt;&lt;div style='font-size:10px;color:#444;margin-top:4px'&gt;&lt;i&gt;writes (operator.add reducers):&lt;/i&gt; item_results, red_flags, errors&lt;/div&gt;&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="80" y="1119" width="1000" height="165" as="geometry"/></mxCell><mxCell id="n16" value="&lt;div style='text-align:left;padding:4px 6px'&gt;&lt;b style='font-size:14px'&gt;verify&lt;/b&gt;&lt;span style='float:right;font-size:10px;color:#555'&gt;code + LLM&lt;/span&gt;&lt;ul style='margin:6px 0 4px 0;padding-left:16px;font-size:11px'&gt;&lt;li&gt;Code: drop evidence refs that no longer check out; a PASS left without evidence becomes CANNOT_DETERMINE&lt;/li&gt;&lt;li&gt;LLM second reviewer (up to 4 in parallel) re-checks every FAIL, every PASS when confidence &amp;lt; 0.7, and every red flag&lt;/li&gt;&lt;li&gt;Can only uphold or downgrade (to CANNOT_DETERMINE / drop the red flag), never upgrade&lt;/li&gt;&lt;/ul&gt;&lt;div style='font-size:10px;color:#444'&gt;&lt;i&gt;writes:&lt;/i&gt; verified_results, verified_red_flags&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#dae8fc;strokeColor=#6c8ebf;verticalAlign=top;align=left;" vertex="1" parent="1"><mxGeometry x="330" y="1344" width="500" height="150" as="geometry"/></mxCell><mxCell id="n17" value="&lt;div style='text-align:left;padding:4px 6px'&gt;&lt;b style='font-size:14px'&gt;decide  (Stage 3: decisions)&lt;/b&gt;&lt;span style='float:right;font-size:10px;color:#555'&gt;code first, LLM fallback&lt;/span&gt;&lt;ul style='margin:6px 0 4px 0;padding-left:16px;font-size:11px'&gt;&lt;li&gt;1. Escalation: escalation_rules.yaml in order; LLM only if no rule fires but a Stage 2 item is PARTIAL / CANNOT_DETERMINE&lt;/li&gt;&lt;li&gt;2. Post-call actions (LLM), action_type limited to ownership.yaml keys; raise_case added whenever escalation is required&lt;/li&gt;&lt;li&gt;3. Ownership: action_type -&amp;gt; owner_role lookup in ownership.yaml (code)&lt;/li&gt;&lt;li&gt;Emits C07 Escalation, C08 Post-call action, C09 Task ownership&lt;/li&gt;&lt;/ul&gt;&lt;div style='font-size:10px;color:#444'&gt;&lt;i&gt;writes:&lt;/i&gt; escalation, actions, item_results (C07-C09)&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#fff2cc;strokeColor=#d6b656;verticalAlign=top;align=left;" vertex="1" parent="1"><mxGeometry x="330" y="1539" width="500" height="175" as="geometry"/></mxCell><mxCell id="n18" value="&lt;div style='text-align:left;padding:4px 6px'&gt;&lt;b style='font-size:14px'&gt;aggregate&lt;/b&gt;&lt;span style='float:right;font-size:10px;color:#555'&gt;code&lt;/span&gt;&lt;ul style='margin:6px 0 4px 0;padding-left:16px;font-size:11px'&gt;&lt;li&gt;Merge item_results with verified_results (verified wins per item)&lt;/li&gt;&lt;li&gt;Exactly one result per checklist item, in config order; a missing branch becomes CANNOT_DETERMINE&lt;/li&gt;&lt;li&gt;Summary: status counts, escalation, red flags, warnings, needs_review + review_reasons&lt;/li&gt;&lt;/ul&gt;&lt;div style='font-size:10px;color:#444'&gt;&lt;i&gt;writes:&lt;/i&gt; final_results, final_red_flags, summary&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#d5e8d4;strokeColor=#82b366;verticalAlign=top;align=left;" vertex="1" parent="1"><mxGeometry x="330" y="1759" width="500" height="140" as="geometry"/></mxCell><mxCell id="n19" value="&lt;div style='text-align:left;padding:4px 6px'&gt;&lt;b style='font-size:14px'&gt;output&lt;/b&gt;&lt;span style='float:right;font-size:10px;color:#555'&gt;code&lt;/span&gt;&lt;ul style='margin:6px 0 4px 0;padding-left:16px;font-size:11px'&gt;&lt;li&gt;Build payload (schema_version 1, model info, cited rule texts)&lt;/li&gt;&lt;li&gt;JsonFileWriter -&amp;gt; output/&amp;lt;call_id&amp;gt;.json (PostgresWriter is a stub)&lt;/li&gt;&lt;li&gt;Never raises: writer failures go to errors&lt;/li&gt;&lt;/ul&gt;&lt;div style='font-size:10px;color:#444'&gt;&lt;i&gt;writes:&lt;/i&gt; (persisted JSON)&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#d5e8d4;strokeColor=#82b366;verticalAlign=top;align=left;" vertex="1" parent="1"><mxGeometry x="330" y="1944" width="500" height="115" as="geometry"/></mxCell><mxCell id="n20" value="END" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="530.0" y="2104" width="100" height="40" as="geometry"/></mxCell><mxCell id="n21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;" edge="1" parent="1" source="n3" target="n4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;" edge="1" parent="1" source="n4" target="n5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;" edge="1" parent="1" source="n5" target="n6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;" edge="1" parent="1" source="n6" target="n7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n25" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;" edge="1" parent="1" source="n7" target="n8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n26" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n8" target="n10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n27" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n10" target="n16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n28" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n8" target="n11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n29" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n11" target="n16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n30" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n8" target="n12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n31" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n12" target="n16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n32" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n8" target="n13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n33" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n13" target="n16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n34" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n8" target="n14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n35" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n14" target="n16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n36" value="no Stage 2 items" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;dashed=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n8" target="n16"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1140" y="894"/><mxPoint x="1140" y="1419"/></Array></mxGeometry></mxCell><mxCell id="n37" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;" edge="1" parent="1" source="n16" target="n17"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n38" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;" edge="1" parent="1" source="n17" target="n18"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n39" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;" edge="1" parent="1" source="n18" target="n19"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n40" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;" edge="1" parent="1" source="n19" target="n20"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n41" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="900" y="90" width="210" height="130" as="geometry"/></mxCell><mxCell id="n42" value="&lt;b&gt;Legend&lt;/b&gt;" style="text;html=1;align=left;" vertex="1" parent="1"><mxGeometry x="910" y="95" width="180" height="20" as="geometry"/></mxCell><mxCell id="n43" value="" style="rounded=1;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="910" y="122" width="30" height="20" as="geometry"/></mxCell><mxCell id="n44" value="plain code" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="948" y="122" width="160" height="20" as="geometry"/></mxCell><mxCell id="n45" value="" style="rounded=1;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="910" y="152" width="30" height="20" as="geometry"/></mxCell><mxCell id="n46" value="LLM call (Gemini)" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="948" y="152" width="160" height="20" as="geometry"/></mxCell><mxCell id="n47" value="" style="rounded=1;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="910" y="182" width="30" height="20" as="geometry"/></mxCell><mxCell id="n48" value="code first, LLM fallback" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="948" y="182" width="160" height="20" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
