GOOGLE_API_KEY=
CLEARCALL_MODEL_ID=gemini-3.5-flash
GOOGLE_EMBEDDING_MODEL=gemini-embedding-001
CLEARCALL_TEMPERATURE=1
LANGSMITH_TRACING=false

# Use 1 for a baseline. Five-item groups reduce repeated transcript input.
COMPLIANCE_CHECK_BATCH_SIZE=1
# Optional recovery groups for malformed/missing answers only (1 preserves individual recovery).
# Valid semantic answers are never retried. A remaining unusable row uses bounded item recovery.
COMPLIANCE_CHECK_RECOVERY_BATCH_SIZE=1
# When validating a low-effort grouped profile, also set its individual fallback effort explicitly.
# COMPLIANCE_CHECK_ITEM_THINKING_LEVEL=low
# Optional task-specific model policies (unset values retain the shared model/default effort).
# COMPLIANCE_CALL_INTENT_MODEL_ID=<separately_validated_model>
# COMPLIANCE_CALL_INTENT_THINKING_LEVEL=low
# COMPLIANCE_CHECK_BATCH_THINKING_LEVEL=low
# COMPLIANCE_CHECK_BATCH_MAX_OUTPUT_TOKENS=16384
# Lower thinking effort is an opt-in profile: validate quality before deployment.
# Retain output headroom; reasoning and the structured answer share this limit.
# COMPLIANCE_DECIDE_ACTIONS_THINKING_LEVEL=low
# COMPLIANCE_DECIDE_ACTIONS_REPAIR_THINKING_LEVEL=medium

# Optional implicit-cache warm-up: retain the first normal question/group, then fan out.
# No extra priming request. No guaranteed cache hit; disabled for native Batch transport.
COMPLIANCE_CHECK_CACHE_WARMUP=0
# Native Google Batch API (asynchronous, potentially 24 hours), distinct from question grouping.
# Standard transport remains the interactive default. Only check_item/check_batch use this setting.
COMPLIANCE_CHECK_TRANSPORT=standard
# COMPLIANCE_BATCH_API_MAX_REQUESTS=20
# COMPLIANCE_BATCH_API_POLL_SECONDS=10
# COMPLIANCE_BATCH_API_MAX_WAIT_SECONDS=86400
# COMPLIANCE_BATCH_API_RECEIPTS=output/native-batch-jobs

# Shared evaluation dashboard. These two values are all that is needed to view it AND to
# publish runs with upload_run.py (there is no publisher login). Treat the key as a team secret.
# Never commit a real .env, or a Supabase secret/service-role key.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
EVALUATION_DEFAULT_SOURCE=Shared

# Optional: play the original speech-to-text recordings in the dashboard (path to fyp-be/evaluation-dataset/datasets)
# STT_AUDIO_ROOT=/other/datasets   (optional; defaults to ../fyp-be/evaluation-dataset/datasets, relative to the fyp-ai folder)
