GOOGLE_API_KEY=
CLEARCALL_MODEL_ID=gemini-3.5-flash
GOOGLE_EMBEDDING_MODEL=gemini-embedding-001
CLEARCALL_TEMPERATURE=1
LANGSMITH_TRACING=false

# Use 1 for a baseline. Five-item groups reduce repeated transcript input.
COMPLIANCE_CHECK_BATCH_SIZE=1
# Optional task-specific model policies (unset values retain the shared model/default effort).
# COMPLIANCE_CALL_INTENT_MODEL_ID=<separately_validated_model>
# COMPLIANCE_CALL_INTENT_THINKING_LEVEL=low
# COMPLIANCE_CHECK_BATCH_THINKING_LEVEL=medium
# COMPLIANCE_CHECK_BATCH_MAX_OUTPUT_TOKENS=16384
# COMPLIANCE_DECIDE_ACTIONS_THINKING_LEVEL=low
# COMPLIANCE_DECIDE_ACTIONS_REPAIR_THINKING_LEVEL=medium

# Shared evaluation dashboard. These two values are all that is needed to view it AND to
# publish runs with upload_run.py (there is no publisher login). Treat the key as a team secret.
# Never commit a real .env, or a Supabase secret/service-role key.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
EVALUATION_DEFAULT_SOURCE=Shared
